{
  "name": "diwan-sufi-frontend",
  "version": "1.0.0",
  "description": "ديوان الصوفية - Frontend",
  "main": "index.html",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css --minify && node scripts/postcss-build.cjs",
    "watch:css": "tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "build:js": "esbuild \"js/**/*.js\" --outdir=dist/js --outbase=js --target=safari12 --format=esm"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1",
    "@tailwindcss/forms": "^0.5.7",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.3",
    "autoprefixer": "^10.4.21"
  },
  "browserslist": [
    "iOS >= 12"
  ]
}
